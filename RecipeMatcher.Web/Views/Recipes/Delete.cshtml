@model Recipe

<h1>Delete</h1>
<p>Delete @Model.Name?</p>
<p>@Model.PreparationMinutes minutes</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="btn-row">
        <button type="submit" class="btn">Delete</button>
        <a class="btn" asp-action="Index">Cancel</a>
    </div>
</form>