@model List<Recipe>

<h1>Recipes</h1>

<p>
    <a class="btn" asp-action="Create">Create recipe</a>
    <a class="btn" asp-controller="Matcher" asp-action="Index">Find a match</a>
</p>

@foreach (var recipe in Model)
{
    <p>
        @recipe.Name
        <a class="btn" asp-action="Details" asp-route-id="@recipe.Id">Details</a>
        <a class="btn" asp-action="Edit" asp-route-id="@recipe.Id">Edit</a>
        <a class="btn" asp-action="Delete" asp-route-id="@recipe.Id">Delete</a>
    </p>
}