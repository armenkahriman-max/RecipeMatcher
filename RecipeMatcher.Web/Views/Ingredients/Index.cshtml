@model List<Ingredient>

<h1>Ingredients</h1>

<p>
    <a class="btn" asp-action="Create">Add ingredient</a>
</p>

@foreach (var ingredient in Model)
{
   
    <p>
        @ingredient.Name
        <a class="btn" asp-action="Edit" asp-route-id="@ingredient.Id">Edit</a>
        <a class="btn" asp-action="Delete" asp-route-id="@ingredient.Id">Delete</a>
    </p>
}
